<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/meow_canvas"
    android:padding="16dp">

    <!-- 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mirage 内核管理"
            android:textColor="@color/meow_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceAbi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#64748B"
            android:textSize="11sp"
            tools:text="设备: arm64-v8a" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="支持动态替换或升级 mirage-core 原生动态库 (.so)"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <!-- 当前运行内核卡片 -->
    <com.google.android.material.card.MaterialCardView
        style="@style/MirageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#0A0077CC"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/meow_blue">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前激活内核:"
                android:textColor="@color/meow_blue"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentCoreName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/meow_ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="内置默认内核" />

            <TextView
                android:id="@+id/tvCurrentCoreVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#334155"
                android:textSize="11sp"
                tools:text="mirage-core 0.1.0 / vendored v0.9.2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 内核列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="220dp"
        tools:listitem="@layout/item_core" />

    <!-- 在线下载与进度展示 -->
    <LinearLayout
        android:id="@+id/layoutDownloadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDownloadStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/meow_blue"
                android:textSize="12sp"
                android:text="正在下载在线内核..." />

            <TextView
                android:id="@+id/tvDownloadPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/meow_blue"
                android:textSize="12sp"
                android:text="0%" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBarDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:indicatorColor="@color/meow_blue"
            app:trackColor="#E2E8F0"
            app:trackCornerRadius="4dp" />
    </LinearLayout>

    <!-- 底部按钮区 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckOnlineCore"
        style="@style/MirageButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="检查 GitHub 在线内核 (Releases)"
        android:textSize="13sp"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_refresh"
        app:iconGravity="textStart"
        app:iconSize="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportCore"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="导入本地 (.so)"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetBuiltin"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="恢复内置默认"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/meow_outline" />
    </LinearLayout>
</LinearLayout>
