<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/meow_canvas"
    android:padding="16dp">

    <!-- 顶栏标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rules_title"
            android:textAppearance="@style/TextAppearance.Mirage.Display"
            android:textColor="@color/meow_ink"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetHits"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:paddingHorizontal="8dp"
            android:text="@string/rules_clear_stats"
            android:textAppearance="@style/TextAppearance.Mirage.Label"
            android:textColor="@color/meow_ink_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/defaultActionBtn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:paddingHorizontal="10dp"
            android:text="@string/rules_default_proxy"
            android:textAppearance="@style/TextAppearance.Mirage.Label"
            app:cornerRadius="8dp"
            app:strokeColor="@color/meow_outline" />
    </LinearLayout>

    <!-- Geo 规则集 (geosite.dat / geoip.dat) 资产中心卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGeoAssetCenter"
        style="@style/MirageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/badge_latency_bg"
                android:padding="6dp"
                android:src="@drawable/ic_nav_nodes"
                app:tint="@color/meow_blue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rules_geo_entry"
                    android:textAppearance="@style/TextAppearance.Mirage.Body"
                    android:textColor="@color/meow_ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGeoStatusSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/rules_geo_entry_desc"
                    android:textAppearance="@style/TextAppearance.Mirage.Caption"
                    android:textColor="@color/meow_ink_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/meow_ink_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 分应用代理 (Per-App Proxy) 快速配置入口 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAppFilter"
        style="@style/MirageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/badge_latency_bg"
                android:padding="6dp"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/meow_connected" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rules_perapp_entry"
                    android:textAppearance="@style/TextAppearance.Mirage.Body"
                    android:textColor="@color/meow_ink"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppFilterSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/rules_perapp_entry_desc"
                    android:textAppearance="@style/TextAppearance.Mirage.Caption"
                    android:textColor="@color/meow_ink_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/meow_ink_secondary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 拖拽排序提示栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/rules_list_label"
            android:textAppearance="@style/TextAppearance.Mirage.Body"
            android:textColor="@color/meow_ink"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rules_drag_hint"
            android:textAppearance="@style/TextAppearance.Mirage.Caption"
            android:textColor="@color/meow_ink_secondary" />
    </LinearLayout>

    <!-- 自定义规则列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginVertical="4dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRules"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            tools:listitem="@layout/item_rule" />

        <TextView
            android:id="@+id/tvEmptyRules"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/rules_empty"
            android:textAppearance="@style/TextAppearance.Mirage.Body"
            android:textColor="@color/meow_ink_secondary"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部按钮组 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickGeoPreset"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/rules_presets"
            android:textAppearance="@style/TextAppearance.Mirage.Label"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addRuleBtn"
            style="@style/MirageButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/rules_add"
            android:textAppearance="@style/TextAppearance.Mirage.Label"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyRulesBtn"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:text="@string/rules_apply"
            android:textAppearance="@style/TextAppearance.Mirage.Label"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
