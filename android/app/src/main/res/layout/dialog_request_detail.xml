<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/meow_canvas"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- 顶部抓手条 (Drag Handle) -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_telegram_avatar"
        android:backgroundTint="@color/meow_outline" />

    <!-- 头部标题与协议徽章 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDetailProtocol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_telegram_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="TCP"
            android:textColor="@color/meow_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/meow_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="api.github.com:443" />
    </LinearLayout>

    <!-- 基本信息卡片 (Inset Grouped) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/meow_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/meow_outline"
        app:strokeWidth="0.8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 目标 Host -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="请求目标"
                    android:textColor="@color/meow_ink_secondary"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/tvHostValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/meow_ink"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="api.github.com:443" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginVertical="8dp"
                android:background="@color/meow_outline" />

            <!-- 解析 IP / Fake-IP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="解析地址"
                    android:textColor="@color/meow_ink_secondary"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/tvIpValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/meow_ink"
                    android:textSize="12.5sp"
                    tools:text="198.18.0.5 (Fake-IP)" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginVertical="8dp"
                android:background="@color/meow_outline" />

            <!-- 出站策略 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="出站策略"
                    android:textColor="@color/meow_ink_secondary"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/tvOutboundValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/meow_blue"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="PROXY (Speedtest-HK)" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginVertical="8dp"
                android:background="@color/meow_outline" />

            <!-- 命中规则 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="匹配规则"
                    android:textColor="@color/meow_ink_secondary"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/tvRuleValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/meow_ink"
                    android:textSize="12.5sp"
                    tools:text="Rule: DOMAIN-SUFFIX (github.com)" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginVertical="8dp"
                android:background="@color/meow_outline" />

            <!-- 状态结果 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="连接状态"
                    android:textColor="@color/meow_ink_secondary"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/tvStatusValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/meow_connected"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="Closed (ServerClosed)" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 传输指标卡片 (Inset Grouped) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/meow_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/meow_outline"
        app:strokeWidth="0.8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 持续耗时 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="持续时间"
                    android:textColor="@color/meow_ink_secondary"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/tvDurationValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/meow_ink"
                    android:textSize="12.5sp"
                    tools:text="45 ms" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginVertical="8dp"
                android:background="@color/meow_outline" />

            <!-- 上传流量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="上传数据"
                    android:textColor="@color/meow_ink_secondary"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/tvUploadValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/meow_ink"
                    android:textSize="12.5sp"
                    tools:text="1.2 KB (1,234 B)" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.6dp"
                android:layout_marginVertical="8dp"
                android:background="@color/meow_outline" />

            <!-- 下载流量 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="下载数据"
                    android:textColor="@color/meow_ink_secondary"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/tvDownloadValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/meow_ink"
                    android:textSize="12.5sp"
                    tools:text="45.8 KB (46,890 B)" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyDetail"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="复制详情"
            android:textSize="13sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseConn"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="重置切断"
            android:textColor="@color/meow_error"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/meow_error" />
    </LinearLayout>
</LinearLayout>
