<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/meow_canvas"
    android:fillViewport="true">

    <!--
        paddingBottom 要放得下悬浮胶囊导航栏 (64dp + 12dp 下边距), 否则最后一个
        控件会被压住 —— 真机截图实测踩过。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="92dp">

        <!--
            第一行就是主操作。
            此前连接按钮在最底下 (后来固定在滚动区外), 首页第一屏被品牌头占掉
            一大块。版本 / 构建信息已经在设置页的「版本与运行环境详情」里, 首页
            不必再放一遍。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectBtn"
                style="@style/MirageButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/connect"
                android:textAppearance="@style/TextAppearance.Mirage.Title"
                app:cornerRadius="24dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_open"
                android:src="@drawable/ic_settings"
                app:tint="@color/meow_ink" />
        </LinearLayout>

        <!-- Surge 模式三段切换器 (胶囊外框 + 等宽三分) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleOutboundMode"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            app:checkedButton="@id/btnModeRule"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeRule"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/mode_rule"
                android:textAppearance="@style/TextAppearance.Mirage.Label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeProxy"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/mode_global"
                android:textAppearance="@style/TextAppearance.Mirage.Label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModeDirect"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/mode_direct"
                android:textAppearance="@style/TextAppearance.Mirage.Label" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 主状态 Hero 卡片 (圆角 14dp) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MirageCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 状态指示点与标题 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/bg_telegram_avatar" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/status_syncing"
                        android:textAppearance="@style/TextAppearance.Mirage.Title"
                        android:textColor="@color/meow_disconnected"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLatency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Mirage.Label"
                    android:textColor="@color/meow_ink_secondary"
                    android:visibility="gone"
                    tools:text="隧道 RTT: 42ms"
                    tools:visibility="visible" />

                <!-- 选中策略节点条目 (Surge Policy Row) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/nodeSelectCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/meow_canvas"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/meow_outline"
                    app:strokeWidth="0.8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="10dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_telegram_avatar"
                            android:padding="5dp"
                            android:src="@drawable/ic_nav_nodes"
                            app:tint="@color/meow_blue" />

                        <TextView
                            android:id="@+id/currentNode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/home_no_node"
                            android:textAppearance="@style/TextAppearance.Mirage.Body"
                            android:textColor="@color/meow_ink"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_switch_node"
                            android:textAppearance="@style/TextAppearance.Mirage.Label"
                            android:textColor="@color/meow_blue"
                            android:textStyle="bold" />

                        <!-- 新增节点: 常用到不该藏在二级页里 -->
                        <ImageButton
                            android:id="@+id/btnAddNode"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/nodes_add"
                            android:padding="6dp"
                            android:src="@drawable/ic_add"
                            app:tint="@color/meow_blue" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Surge 级速率图与平滑波形 (Sparkline Rate Card) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MirageCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rate_up_label"
                            android:textAppearance="@style/TextAppearance.Mirage.Caption"
                            android:textColor="@color/meow_upload"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/upRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFeatureSettings="tnum"
                            android:text="0 B/s"
                            android:textAppearance="@style/TextAppearance.Mirage.Display"
                            android:textColor="@color/meow_ink"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/rate_down_label"
                            android:textAppearance="@style/TextAppearance.Mirage.Caption"
                            android:textColor="@color/meow_download"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/downRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFeatureSettings="tnum"
                            android:text="0 B/s"
                            android:textAppearance="@style/TextAppearance.Mirage.Display"
                            android:textColor="@color/meow_ink"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 平滑迷你波形 (Sparkline) -->
                <com.mirage.android.TrafficChart
                    android:id="@+id/homeChart"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.6dp"
                    android:layout_marginVertical="8dp"
                    android:background="@color/meow_outline" />

                <!-- 底部指标行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/totalFlow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/home_total_zero"
                        android:textAppearance="@style/TextAppearance.Mirage.Caption"
                        android:textColor="@color/meow_ink_secondary" />

                    <TextView
                        android:id="@+id/connsInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:text="@string/home_conns_zero"
                        android:textAppearance="@style/TextAppearance.Mirage.Caption"
                        android:textColor="@color/meow_ink_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/todayUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFeatureSettings="tnum"
                    android:text="@string/home_today_zero"
                    android:textAppearance="@style/TextAppearance.Mirage.Caption"
                    android:textColor="@color/meow_ink_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



    </LinearLayout>
</ScrollView>
